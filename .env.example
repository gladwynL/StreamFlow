# Copy to .env before running Docker Compose:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# --- Required -------------------------------------------------------------
# Local-only database password. Generate one, for example:
#   PowerShell:  [guid]::NewGuid().ToString('N')
#   bash:        openssl rand -hex 16
POSTGRES_PASSWORD=

# --- Optional ----------------------------------------------------------------
# Operator key for dead-letter replay and discard (header X-StreamFlow-Operator-Key).
# Leave empty to keep those operations disabled. Generate one the same way as the password.
STREAMFLOW_OPERATOR_KEY=

# --- Images (single source of truth for Compose; integration tests must match) ---
KAFKA_IMAGE=apache/kafka:4.3.2
POSTGRES_IMAGE=postgres:18.6-alpine

# --- Kafka ------------------------------------------------------------------
# KRaft cluster id: any 16 bytes, base64url-encoded without padding. Not a secret.
KAFKA_CLUSTER_ID=c3RyZWFtZmxvdy1sb2NhbA

# --- Host ports (published on 127.0.0.1 only) ------------------------------
KAFKA_HOST_PORT=9094
POSTGRES_HOST_PORT=5432
WEB_HOST_PORT=8080
