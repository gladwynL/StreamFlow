# Recovery: 2 workers x 3 threads drain 60,000 events (record mode); one worker is killed 15 s after start
# and restarted 15 s after the kill. The run must still reconcile exactly.
NAME=kill-record-2w-c3
WORKLOAD=backlog
EVENTS=60000
WORKERS=2
CONCURRENCY=3
PROCESSING_MODE=RECORD
KILL_WORKER_AFTER=15
RESTART_KILLED_AFTER=15
