# Recovery: 2 workers x 3 threads process 3,000 events/s offered for 60 s (batch mode); one worker is killed
# 20 s after the workers start and restarted 15 s after the kill. The run must still reconcile exactly.
NAME=kill-batch-2w-c3
WORKLOAD=live
EVENTS=180000
RATE=3000
WORKERS=2
CONCURRENCY=3
PROCESSING_MODE=BATCH
KILL_WORKER_AFTER=20
RESTART_KILLED_AFTER=15
